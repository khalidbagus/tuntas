rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Tuntas stores per-user sync state and lightweight progress records
// strictly scoped under /users/{uid}/... (path-based ownership; no
// in-document uid field and no parent /users/{uid} document required).
// Local-only sensitive document content (e.g., text, evidence, facts,
// proposal, followUp, quote, bytes, reason, name, mime, size, digest,
// suggestionKey) MUST remain in browser IndexedDB and is rejected on write.
// Hard deletes are disabled across all collections; deletions use
// soft-delete tombstones (deleted == true).
//
// Collection: users/{uid}/settings/{settingId}
// Document ID: 'sync'
// Fields:
//   - enabled: bool (required) - whether cloud progress sync is enabled
//   - updatedAt: int | float >= 0 (required) - epoch ms timestamp
//
// Collection: users/{uid}/documents/{docId}
// Document ID: document id (matches data.id)
// Fields:
//   - id: string (required, immutable == docId)
//   - title: string (required, max 120 chars)
//   - category: string enum (required: Money & Bills | Home & Living | Work & Study | Purchases | Personal Records | Other)
//   - tags: list<string> (required, max 10 items, each string max 200 chars)
//   - status: string enum (required: pending | processing | needs_review | organized | error)
//   - created: int | float >= 0 (required)
//   - updatedAt: int | float >= 0 (required)
//   - deleted: bool (required; permanent tombstone once true)
//   - deletedAt: null | int | float >= 0 (required)
//
// Collection: users/{uid}/actions/{actionId}
// Document ID: action id (matches data.id)
// Fields:
//   - id: string (required, immutable == actionId)
//   - documentId: string (required, max 120 chars)
//   - title: string (required, max 140 chars)
//   - due: string (required, max 10 chars, YYYY-MM-DD or '')
//   - done: bool (required)
//   - groupId: string (required, max 80 chars)
//   - created: int | float >= 0 (required)
//   - updatedAt: int | float >= 0 (required)
//   - deleted: bool (required; permanent tombstone once true)
//   - deletedAt: null | int | float >= 0 (required)
//
// Collection: users/{uid}/actionGroups/{groupId}
// Document ID: group id (matches data.id)
// Fields:
//   - id: string (required, immutable == groupId)
//   - title: string (required, max 80 chars)
//   - created: int | float >= 0 (required)
//   - updated: int | float >= 0 (required)
//   - updatedAt: int | float >= 0 (required)
//   - deleted: bool (required; permanent tombstone once true)
//   - deletedAt: null | int | float >= 0 (required)
//
// Collection: users/{uid}/actionDependencies/{depId}
// Document ID: dependency id (matches data.id)
// Fields:
//   - id: string (required, immutable == depId)
//   - prerequisiteActionId: string (required, 1..120 chars, != dependentActionId)
//   - dependentActionId: string (required, 1..120 chars, != prerequisiteActionId)
//   - created: int | float >= 0 (required)
//   - updatedAt: int | float >= 0 (required)
//   - deleted: bool (required; re-link allowed only when next.updatedAt > existing.updatedAt)
//   - deletedAt: null | int | float >= 0 (required)
//
// Collection: splits/{splitId}
// Document ID: split id (matches data.id)
// Fields:
//   - id: string (required, immutable == splitId)
//   - organizerUid: string (required, 1..128 chars, == auth.uid on create, immutable)
//   - organizerEmail: string (required, max 120 chars, immutable)
//   - title: string (required, 1..120 chars)
//   - currency: string enum (required: IDR | USD | SGD | EUR | GBP)
//   - totalAmount: int | float > 0 (required)
//   - splitMode: string enum (required: equal | itemized)
//   - itemsSummary: string (required, max 1000 chars)
//   - paymentInstructions: string (required, max 500 chars)
//   - participantEmails: list<string> (required, max 12 items, each string max 120 chars)
//   - status: string enum (required: open | settled | canceled)
//   - createdAt: int | float >= 0 (required, immutable)
//   - updatedAt: int | float >= 0 (required)
//
// Collection: splits/{splitId}/shares/{shareId}
// Document ID: share id (matches data.id)
// Fields:
//   - id: string (required, immutable == shareId)
//   - splitId: string (required, immutable == splitId)
//   - organizerUid: string (required, 1..128 chars, immutable; == auth.uid and parent split organizerUid on create)
//   - participantName: string (required, 1..80 chars)
//   - participantEmail: string (required, max 120 chars, immutable)
//   - participantUid: string (required, max 128 chars)
//   - amount: int | float >= 0 (required)
//   - note: string (required, max 240 chars)
//   - status: string enum (required: pending | accepted | declined | paid_pending_confirm | confirmed)
//   - paymentMethod: string enum (required: '' | qris_bank_ewallet | google_pay_sandbox)
//   - proofSummary: string (required, max 400 chars)
//   - proofVerifiedByAi: bool (required)
//   - updatedAt: int | float >= 0 (required)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the request comes from an authenticated user.
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated caller owns the /users/{uid} namespace.
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Enforce exact allowlisted fields and verify all required fields exist.
    function hasOnlyAllowedFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    // Validate finite non-negative epoch millisecond timestamps.
    function isValidTimestampMs(value) {
      return (value is int || value is float) && value >= 0;
    }

    function isNullableTimestampMs(value) {
      return value == null || isValidTimestampMs(value);
    }

    // Deep-validate bounded tag strings inside a list of at most 10 items.
    function isValidTag(tag) {
      return tag is string && tag.size() <= 200;
    }

    function isValidTagList(tags) {
      return tags is list &&
        tags.size() <= 10 &&
        (tags.size() < 1 || isValidTag(tags[0])) &&
        (tags.size() < 2 || isValidTag(tags[1])) &&
        (tags.size() < 3 || isValidTag(tags[2])) &&
        (tags.size() < 4 || isValidTag(tags[3])) &&
        (tags.size() < 5 || isValidTag(tags[4])) &&
        (tags.size() < 6 || isValidTag(tags[5])) &&
        (tags.size() < 7 || isValidTag(tags[6])) &&
        (tags.size() < 8 || isValidTag(tags[7])) &&
        (tags.size() < 9 || isValidTag(tags[8])) &&
        (tags.size() < 10 || isValidTag(tags[9]));
    }

    // Enforce permanent tombstones so offline devices cannot resurrect deleted items.
    function isTombstonePreserved(existing, next) {
      return existing.deleted == false || next.deleted == true;
    }

    // Allow re-linking a deleted dependency only when the incoming write is strictly newer.
    function canUpdateDependency(existing, next) {
      return existing.deleted == false ||
        next.deleted == true ||
        (next.deleted == false && next.updatedAt > existing.updatedAt);
    }

    // Deep-validate bounded participant email strings inside a list of at most 12 items.
    function isValidParticipantEmail(email) {
      return email is string && email.size() <= 120;
    }

    function isValidParticipantEmailList(emails) {
      return emails is list &&
        emails.size() <= 12 &&
        (emails.size() < 1 || isValidParticipantEmail(emails[0])) &&
        (emails.size() < 2 || isValidParticipantEmail(emails[1])) &&
        (emails.size() < 3 || isValidParticipantEmail(emails[2])) &&
        (emails.size() < 4 || isValidParticipantEmail(emails[3])) &&
        (emails.size() < 5 || isValidParticipantEmail(emails[4])) &&
        (emails.size() < 6 || isValidParticipantEmail(emails[5])) &&
        (emails.size() < 7 || isValidParticipantEmail(emails[6])) &&
        (emails.size() < 8 || isValidParticipantEmail(emails[7])) &&
        (emails.size() < 9 || isValidParticipantEmail(emails[8])) &&
        (emails.size() < 10 || isValidParticipantEmail(emails[9])) &&
        (emails.size() < 11 || isValidParticipantEmail(emails[10])) &&
        (emails.size() < 12 || isValidParticipantEmail(emails[11]));
    }

    function hasCallerEmail() {
      return 'email' in request.auth.token &&
        request.auth.token.email != null &&
        request.auth.token.email is string &&
        request.auth.token.email.size() > 0;
    }

    // ===============================================================
    // Domain Validators (Applied on both create and update)
    // ===============================================================

    function isValidSyncSettings(data) {
      return hasOnlyAllowedFields(data, ['enabled', 'updatedAt']) &&
        hasRequiredFields(data, ['enabled', 'updatedAt']) &&
        data.enabled is bool &&
        isValidTimestampMs(data.updatedAt);
    }

    function isValidDocument(data, docId) {
      return hasOnlyAllowedFields(data, [
          'id',
          'title',
          'category',
          'tags',
          'status',
          'created',
          'updatedAt',
          'deleted',
          'deletedAt'
        ]) &&
        hasRequiredFields(data, [
          'id',
          'title',
          'category',
          'tags',
          'status',
          'created',
          'updatedAt',
          'deleted',
          'deletedAt'
        ]) &&
        data.id is string &&
        data.id == docId &&
        data.title is string &&
        data.title.size() <= 120 &&
        data.category in [
          'Money & Bills',
          'Home & Living',
          'Work & Study',
          'Purchases',
          'Personal Records',
          'Other'
        ] &&
        isValidTagList(data.tags) &&
        data.status in [
          'pending',
          'processing',
          'needs_review',
          'organized',
          'error'
        ] &&
        isValidTimestampMs(data.created) &&
        isValidTimestampMs(data.updatedAt) &&
        data.deleted is bool &&
        isNullableTimestampMs(data.deletedAt);
    }

    function isValidAction(data, actionId) {
      return hasOnlyAllowedFields(data, [
          'id',
          'documentId',
          'title',
          'due',
          'done',
          'groupId',
          'created',
          'updatedAt',
          'deleted',
          'deletedAt'
        ]) &&
        hasRequiredFields(data, [
          'id',
          'documentId',
          'title',
          'due',
          'done',
          'groupId',
          'created',
          'updatedAt',
          'deleted',
          'deletedAt'
        ]) &&
        data.id is string &&
        data.id == actionId &&
        data.documentId is string &&
        data.documentId.size() <= 120 &&
        data.title is string &&
        data.title.size() <= 140 &&
        data.due is string &&
        data.due.size() <= 10 &&
        data.done is bool &&
        data.groupId is string &&
        data.groupId.size() <= 80 &&
        isValidTimestampMs(data.created) &&
        isValidTimestampMs(data.updatedAt) &&
        data.deleted is bool &&
        isNullableTimestampMs(data.deletedAt);
    }

    function isValidActionGroup(data, groupId) {
      return hasOnlyAllowedFields(data, [
          'id',
          'title',
          'created',
          'updated',
          'updatedAt',
          'deleted',
          'deletedAt'
        ]) &&
        hasRequiredFields(data, [
          'id',
          'title',
          'created',
          'updated',
          'updatedAt',
          'deleted',
          'deletedAt'
        ]) &&
        data.id is string &&
        data.id == groupId &&
        data.title is string &&
        data.title.size() <= 80 &&
        isValidTimestampMs(data.created) &&
        isValidTimestampMs(data.updated) &&
        isValidTimestampMs(data.updatedAt) &&
        data.deleted is bool &&
        isNullableTimestampMs(data.deletedAt);
    }

    function isValidActionDependency(data, depId) {
      return hasOnlyAllowedFields(data, [
          'id',
          'prerequisiteActionId',
          'dependentActionId',
          'created',
          'updatedAt',
          'deleted',
          'deletedAt'
        ]) &&
        hasRequiredFields(data, [
          'id',
          'prerequisiteActionId',
          'dependentActionId',
          'created',
          'updatedAt',
          'deleted',
          'deletedAt'
        ]) &&
        data.id is string &&
        data.id == depId &&
        data.prerequisiteActionId is string &&
        data.prerequisiteActionId.size() > 0 &&
        data.prerequisiteActionId.size() <= 120 &&
        data.dependentActionId is string &&
        data.dependentActionId.size() > 0 &&
        data.dependentActionId.size() <= 120 &&
        data.prerequisiteActionId != data.dependentActionId &&
        isValidTimestampMs(data.created) &&
        isValidTimestampMs(data.updatedAt) &&
        data.deleted is bool &&
        isNullableTimestampMs(data.deletedAt);
    }

    function isValidSplit(data, splitId) {
      return hasOnlyAllowedFields(data, [
          'id',
          'organizerUid',
          'organizerEmail',
          'title',
          'currency',
          'totalAmount',
          'splitMode',
          'itemsSummary',
          'paymentInstructions',
          'participantEmails',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        hasRequiredFields(data, [
          'id',
          'organizerUid',
          'organizerEmail',
          'title',
          'currency',
          'totalAmount',
          'splitMode',
          'itemsSummary',
          'paymentInstructions',
          'participantEmails',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.id is string &&
        data.id == splitId &&
        data.organizerUid is string &&
        data.organizerUid.size() > 0 &&
        data.organizerUid.size() <= 128 &&
        data.organizerEmail is string &&
        data.organizerEmail.size() <= 120 &&
        data.title is string &&
        data.title.size() > 0 &&
        data.title.size() <= 120 &&
        data.currency in ['IDR', 'USD', 'SGD', 'EUR', 'GBP'] &&
        (data.totalAmount is int || data.totalAmount is float) &&
        data.totalAmount > 0 &&
        data.splitMode in ['equal', 'itemized'] &&
        data.itemsSummary is string &&
        data.itemsSummary.size() <= 1000 &&
        data.paymentInstructions is string &&
        data.paymentInstructions.size() <= 500 &&
        isValidParticipantEmailList(data.participantEmails) &&
        data.status in ['open', 'settled', 'canceled'] &&
        isValidTimestampMs(data.createdAt) &&
        isValidTimestampMs(data.updatedAt);
    }

    function isValidSplitShare(data, splitId, shareId) {
      return hasOnlyAllowedFields(data, [
          'id',
          'splitId',
          'organizerUid',
          'participantName',
          'participantEmail',
          'participantUid',
          'amount',
          'note',
          'status',
          'paymentMethod',
          'proofSummary',
          'proofVerifiedByAi',
          'updatedAt'
        ]) &&
        hasRequiredFields(data, [
          'id',
          'splitId',
          'organizerUid',
          'participantName',
          'participantEmail',
          'participantUid',
          'amount',
          'note',
          'status',
          'paymentMethod',
          'proofSummary',
          'proofVerifiedByAi',
          'updatedAt'
        ]) &&
        data.id is string &&
        data.id == shareId &&
        data.splitId is string &&
        data.splitId == splitId &&
        data.organizerUid is string &&
        data.organizerUid.size() > 0 &&
        data.organizerUid.size() <= 128 &&
        data.participantName is string &&
        data.participantName.size() > 0 &&
        data.participantName.size() <= 80 &&
        data.participantEmail is string &&
        data.participantEmail.size() <= 120 &&
        data.participantUid is string &&
        data.participantUid.size() <= 128 &&
        (data.amount is int || data.amount is float) &&
        data.amount >= 0 &&
        data.note is string &&
        data.note.size() <= 240 &&
        data.status in [
          'pending',
          'accepted',
          'declined',
          'paid_pending_confirm',
          'confirmed'
        ] &&
        data.paymentMethod in [
          '',
          'qris_bank_ewallet',
          'google_pay_sandbox'
        ] &&
        data.proofSummary is string &&
        data.proofSummary.size() <= 400 &&
        data.proofVerifiedByAi is bool &&
        isValidTimestampMs(data.updatedAt);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /users/{uid}/settings/{settingId} {
      allow read: if isOwner(uid) && settingId == 'sync';
      allow create: if isOwner(uid) &&
        settingId == 'sync' &&
        isValidSyncSettings(request.resource.data);
      allow update: if isOwner(uid) &&
        settingId == 'sync' &&
        isValidSyncSettings(request.resource.data);
      allow delete: if false;
    }

    match /users/{uid}/documents/{docId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) &&
        isValidDocument(request.resource.data, docId);
      allow update: if isOwner(uid) &&
        isValidDocument(request.resource.data, docId) &&
        isTombstonePreserved(resource.data, request.resource.data);
      allow delete: if false;
    }

    match /users/{uid}/actions/{actionId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) &&
        isValidAction(request.resource.data, actionId);
      allow update: if isOwner(uid) &&
        isValidAction(request.resource.data, actionId) &&
        isTombstonePreserved(resource.data, request.resource.data);
      allow delete: if false;
    }

    match /users/{uid}/actionGroups/{groupId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) &&
        isValidActionGroup(request.resource.data, groupId);
      allow update: if isOwner(uid) &&
        isValidActionGroup(request.resource.data, groupId) &&
        isTombstonePreserved(resource.data, request.resource.data);
      allow delete: if false;
    }

    match /users/{uid}/actionDependencies/{depId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) &&
        isValidActionDependency(request.resource.data, depId);
      allow update: if isOwner(uid) &&
        isValidActionDependency(request.resource.data, depId) &&
        canUpdateDependency(resource.data, request.resource.data);
      allow delete: if false;
    }

    match /splits/{splitId} {
      allow read: if isAuthenticated() && (
        resource.data.organizerUid == request.auth.uid ||
        (hasCallerEmail() &&
          request.auth.token.email.lower() in resource.data.participantEmails)
      );
      allow create: if isAuthenticated() &&
        request.resource.data.organizerUid == request.auth.uid &&
        isValidSplit(request.resource.data, splitId);
      allow update: if isAuthenticated() &&
        resource.data.organizerUid == request.auth.uid &&
        isValidSplit(request.resource.data, splitId) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.organizerUid == resource.data.organizerUid &&
        request.resource.data.organizerEmail == resource.data.organizerEmail &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /splits/{splitId}/shares/{shareId} {
      allow read: if isAuthenticated() && (
        resource.data.organizerUid == request.auth.uid ||
        (hasCallerEmail() &&
          request.auth.token.email.lower() == resource.data.participantEmail)
      );
      allow create: if isAuthenticated() &&
        request.resource.data.organizerUid == request.auth.uid &&
        exists(/databases/$(database)/documents/splits/$(splitId)) &&
        get(/databases/$(database)/documents/splits/$(splitId)).data.organizerUid == request.auth.uid &&
        isValidSplitShare(request.resource.data, splitId, shareId);
      allow update: if isValidSplitShare(request.resource.data, splitId, shareId) &&
        isAuthenticated() && (
          (resource.data.organizerUid == request.auth.uid &&
            request.resource.data.id == resource.data.id &&
            request.resource.data.splitId == resource.data.splitId &&
            request.resource.data.organizerUid == resource.data.organizerUid &&
            request.resource.data.participantEmail == resource.data.participantEmail) ||
          (hasCallerEmail() &&
            request.auth.token.email.lower() == resource.data.participantEmail &&
            request.resource.data.id == resource.data.id &&
            request.resource.data.splitId == resource.data.splitId &&
            request.resource.data.organizerUid == resource.data.organizerUid &&
            request.resource.data.participantName == resource.data.participantName &&
            request.resource.data.participantEmail == resource.data.participantEmail &&
            request.resource.data.amount == resource.data.amount &&
            request.resource.data.note == resource.data.note &&
            request.resource.data.status in ['accepted', 'declined', 'paid_pending_confirm'] &&
            (request.resource.data.participantUid == '' ||
              request.resource.data.participantUid == request.auth.uid))
        );
      allow delete: if false;
    }

    // Default deny-all fallback for any unmatched path.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
