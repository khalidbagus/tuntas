# Copy to .env.local only when you have a registered Firebase development web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_APP_CHECK_SITE_KEY=
# Optional private App Check token, registered in Firebase Console.
# Used only by the Vite dev server on a loopback hostname.
# Production builds require a real App Check site key.
TUNTAS_APP_CHECK_DEBUG_TOKEN=

